APP_NAME=KobiConnect
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.kobiconnect.com
APP_DOMAIN=app.kobiconnect.com

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Host degerleri compose servis adlaridir; kobiconnect_backend agi uzerinden cozulur.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kobiconnect
DB_USERNAME=kobiconnect_user
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@kobiconnect.com"
MAIL_FROM_NAME="${APP_NAME}"

OCTANE_SERVER=roadrunner

PASSKEYS_USER_HANDLE_SECRET=

# Tanimsiz birakilirsa APP_URL/hooks kullanilir. Bos deger varsayilani DEVRE DISI birakir.
# WEBHOOK_BASE_URL=https://hooks.kobiconnect.com

# Caddy reverse proxy arkasinda.
TRUSTED_PROXIES=*
