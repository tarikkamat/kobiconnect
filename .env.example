APP_NAME=KobiConnect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://app.kobiconnect.test
APP_DOMAIN=app.kobiconnect.test

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kobiconnect
DB_USERNAME=kobiconnect
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OCTANE_SERVER=roadrunner

PASSKEYS_USER_HANDLE_SECRET=

# Tanimsiz birakilirsa APP_URL/hooks kullanilir.
# DIKKAT: bos deger (WEBHOOK_BASE_URL=) varsayilani DEVRE DISI birakir,
# env() bos string dondurur. Kullanmayacaksan satiri yorumda birak.
# WEBHOOK_BASE_URL=https://hooks.kobiconnect.com

# Cloudflare/proxy arkasindaysa. Origin yalnizca proxy IP araliklarina acik olmali.
TRUSTED_PROXIES=*
